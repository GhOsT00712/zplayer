{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZPLAYER",
  "version": "0.2.0",
  "identifier": "io.zplayer.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm run build", "wait": true },
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist",
    "removeUnusedCommands": true
  },
  "app": { "windows": [] },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "shortDescription": "ZPLAYER",
    "longDescription": "A Zune HD-styled Spotify player for Windows."
  }
}
