{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZPLAYER",
  "version": "0.2.0",
  "identifier": "io.zplayer.android",
  "build": {
    "beforeDevCommand": {
      "script": "npm --prefix ../frontend run build:app",
      "wait": true
    },
    "beforeBuildCommand": "npm --prefix ../frontend run build:app",
    "frontendDist": "../../frontend/dist-app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZPLAYER",
        "width": 412,
        "height": 892
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "ZPLAYER",
    "longDescription": "A Zune HD-styled music player for Android."
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "io.zplayer.android"
          ],
          "host": "callback",
          "appLink": false
        }
      ]
    }
  }
}
